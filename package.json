{
  "name": "finalcac",
  "version": "0.1.0",
  "private": true,
  "description": "Resonance: a phone-first PWA that turns phones into a tamper-alarm network for a store.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "analyze": "node --experimental-strip-types tools/analyze-wav.ts"
  },
  "dependencies": {
    "preact": "^10.26.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.0",
    "@types/node": "^22.20.4",
    "playwright-core": "^1.63.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
